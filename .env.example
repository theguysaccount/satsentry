# SatSentry Optional Non-Custodial L402 Receiver Configuration
# Leave unset to run in honest public preview mode (all endpoints work; no fake invoices).
# Set SATSENTRY_L402_SECRET plus ONE of the three receiver options below to enforce live HTTP 402 Lightning settlement.

# Required when enforcing live L402 macaroons (generate with: openssl rand -hex 32)
SATSENTRY_L402_SECRET=

# Option 1: Lightning Address (LNURL-pay — zero node required)
# SATSENTRY_LNURL_ADDRESS=you@getalby.com

# Option 2: LNbits (self-hosted or managed — invoice/read key only, never admin key)
# SATSENTRY_LNBITS_URL=https://legend.lnbits.com
# SATSENTRY_LNBITS_KEY=

# Option 3: LND REST API (invoice-only macaroon hex, never admin macaroon)
# SATSENTRY_LND_REST_URL=https://127.0.0.1:8080
# SATSENTRY_LND_MACAROON=
